{
  "expo": {
    "name": "Rikna",
    "slug": "rikna-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/rikna-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rikna.demo"
    },
    "android": {
      "package": "com.rikna.demo",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/rikna-logo.png",
        "backgroundColor": "#146375"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/rikna-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-secure-store"
    ],
    "scheme": "rikna"
  }
}
